{
  "name": "asuka-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first coding agent harness: a skinnable desktop shell plus an event-sourced core with a persistent model persona",
  "license": "MIT",
  "author": {
    "name": "Asuka Harness contributors",
    "email": "asuka-harness@users.noreply.github.com"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w @asuka/desktop",
    "dev": "npm run dev -w @asuka/desktop",
    "test": "npm run test --workspaces --if-present",
    "test:core": "npm run test -w @asuka/core",
    "dist": "npm run dist -w @asuka/desktop",
    "dist:linux": "npm run dist:linux -w @asuka/desktop",
    "dist:win": "npm run dist:win -w @asuka/desktop",
    "dist:mac": "npm run dist:mac -w @asuka/desktop"
  }
}
