{
  "name": "@asuka/desktop",
  "version": "0.1.0",
  "description": "Asuka Harness desktop shell: a skinnable Electron window for the harness UI",
  "license": "MIT",
  "private": true,
  "author": {
    "name": "Asuka Harness contributors",
    "email": "asuka-harness@users.noreply.github.com"
  },
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "asuka-harness",
    "deepseek-harness",
    "electron",
    "desktop",
    "skin",
    "wallpaper"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke",
    "test": "node test/config.test.js && node test/dsh-url.test.js && node test/locator.test.js && node test/skins.test.js",
    "check": "node --check src/main.js && node --check src/backend.js && node --check src/skin-manager.js",
    "assets": "python3 scripts/generate-assets.py",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.17.0"
  }
}
